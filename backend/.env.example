# ---------------------------------------------------------------
# MlimiSmart backend configuration
# Copy this file to ".env" and fill in your own values.
# ---------------------------------------------------------------

# --- Database (WAMP MySQL) -------------------------------------
# WAMP default: user "root" with an EMPTY password on port 3306.
# Create the database first in phpMyAdmin:  CREATE DATABASE mlimismart;
DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3310/mlimismart

# If MySQL is not running, the app automatically falls back to this
# SQLite file so you can keep working. Set to "false" to disable.
ALLOW_SQLITE_FALLBACK=true

# --- Security ---------------------------------------------------
# Change this to any long random string before your final submission.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=10080

# --- AI: Google Gemini (optional, free) -------------------------
# Get a free key at https://aistudio.google.com/apikey and paste it below.
# With a key: natural Chichewa/English wording, answers to open questions
# and Leaf Doctor photo checks. Without one, the system still works using
# its built-in bilingual templates and the offline symptom checker.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-flash-latest

# --- SMS gateway (optional, free sandbox) -----------------------
# Sign up at https://africastalking.com -> Sandbox.
# Leave SMS_ENABLED=false to use the built-in SMS simulator instead.
SMS_ENABLED=false
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=

# --- Admin account created by seed.py ---------------------------
ADMIN_PHONE=0999000000
ADMIN_PASSWORD=admin123
