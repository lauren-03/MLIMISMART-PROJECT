# ---------------------------------------------------------------
# MlimiSmart backend configuration
# Copy this file to ".env" and fill in your own values.
# ---------------------------------------------------------------

# --- Database (WAMP MySQL) -------------------------------------
# WAMP default: user "root" with an EMPTY password on port 3306.
# Create the database first in phpMyAdmin:  CREATE DATABASE mlimismart;
DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3310/mlimismart

# If MySQL is not running, the app automatically falls back to this
# SQLite file so you can keep working. Set to "false" to disable.
ALLOW_SQLITE_FALLBACK=true

# --- Security ---------------------------------------------------
# Change this to any long random string before your final submission.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=10080

# --- AI: Google Gemini (optional, free) -------------------------
# Get a free key at https://aistudio.google.com/apikey and paste it below.
# With a key: natural Chichewa/English wording, answers to open questions
# and Leaf Doctor photo checks. Without one, the system still works using
# its built-in bilingual templates and the offline symptom checker.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-flash-latest

# --- SMS ------------------------------------------------------
# SMS_GATEWAY: android (a real phone running "SMS Gateway for Android"),
# africastalking, or simulator (no real messages).
SMS_GATEWAY=simulator
# The number farmers text (the SIM in the gateway phone), shown on the website.
SMS_NUMBER=

# SMS Gateway for Android: turn on "Local Server" in the app and copy the
# address, username and password from its Home tab. The signing key is in
# Settings > Webhooks.
ANDROID_SMS_URL=http://192.168.1.20:8080
ANDROID_SMS_USERNAME=
ANDROID_SMS_PASSWORD=
ANDROID_SMS_SIGNING_KEY=

# --- USSD (Africa's Talking sandbox, free) ----------------------
# Create a sandbox account at https://account.africastalking.com, then
# copy the sandbox API key here.
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=
USSD_CODE=*384*211#

# --- Public address for the gateways -----------------------------
# START_TUNNEL=true opens a free Cloudflare quick tunnel when the API starts
# (needs backend/tools/cloudflared.exe). The address is shown on the USSD page.
START_TUNNEL=false
PUBLIC_URL=

# --- Admin account created by seed.py ---------------------------
ADMIN_PHONE=0999000000
ADMIN_PASSWORD=admin123

# Chichewa voice for Listen: kasanoma (needs backend/voices/kasanoma-chichewa) or mms
CHICHEWA_VOICE=kasanoma
